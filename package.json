{
  "name": "n8n-nodes-auth0",
  "version": "1.0.0",
  "description": "A comprehensive n8n community node for Auth0 Management API providing 8 resources and 80+ operations for user management, organizations, connections, applications, roles, APIs, logs, and actions.",
  "license": "BUSL-1.1",
  "author": {
    "name": "Velocity BPA",
    "email": "licensing@velobpa.com",
    "url": "https://velobpa.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Velocity-BPA/n8n-nodes-auth0.git"
  },
  "homepage": "https://github.com/Velocity-BPA/n8n-nodes-auth0#readme",
  "bugs": {
    "url": "https://github.com/Velocity-BPA/n8n-nodes-auth0/issues"
  },
  "keywords": [
    "n8n",
    "n8n-community-node-package",
    "auth0",
    "identity",
    "authentication",
    "authorization",
    "sso",
    "mfa",
    "oauth",
    "user-management",
    "management-api"
  ],
  "main": "dist/nodes/Auth0/Auth0.node.js",
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/Auth0ManagementApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Auth0/Auth0.node.js",
      "dist/nodes/Auth0/Auth0Trigger.node.js"
    ]
  },
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "gulp": "^4.0.2",
    "jest": "^29.7.0",
    "n8n-workflow": "*",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
